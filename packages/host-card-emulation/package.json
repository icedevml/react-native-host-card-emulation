{
  "name": "@icedevml/react-native-host-card-emulation",
  "version": "1.0.0",
  "description": "Host Card Emulation (HCE) React Native Turbo Module for iOS and Android platforms.",
  "main": "js/index.ts",
  "types": "js/index.ts",
  "react-native": "js/index.ts",
  "source": "js/index.ts",
  "scripts": {
    "test": "jest",
    "typecheck": "tsc"
  },
  "files": [
    "js",
    "jest",
    "android",
    "ios",
    "RTNHCEModuleIOS.podspec",
    "Package.swift",
    "react-native-spm-prefix.h",
    "!android/build",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "keywords": [
    "react-native",
    "ios",
    "nfc",
    "hce"
  ],
  "repository": "https://github.com/icedevml/react-native-host-card-emulation",
  "author": "Michal Leszczynski ml@icedev.pl (https://github.com/icedevml)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/icedevml/react-native-host-card-emulation/issues"
  },
  "homepage": "https://github.com/icedevml/react-native-host-card-emulation#readme",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/jest": "^29.5.13",
    "jest": "^29.6.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "typescript": "^6.0.3"
  },
  "codegenConfig": {
    "name": "RTNHCEModuleSpec",
    "type": "modules",
    "jsSrcsDir": "js",
    "android": {
      "javaPackageName": "com.itsecrnd.rtnhceandroid"
    },
    "ios": {
      "modulesProvider": {
        "NativeHCEModule": "RTNHCEModuleIOS"
      }
    }
  }
}
